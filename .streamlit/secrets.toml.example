# ==============================================================================
# Streamlit Community Cloud Secrets Template (.streamlit/secrets.toml.example)
# DO NOT COMMIT REAL SECRETS TO GIT.
# Copy this file into your platform's Secret Store (e.g. Streamlit Cloud App Settings > Secrets).
# ==============================================================================

[app]
environment = "production"
app_title = "PulseIQ Executive Cockpit"
app_release_version = "v1.0.0-live"
secret_token = "pulseiq_live_secret_key_change_me_in_cloud"

[data_governance]
warehouse_conn_string = "sqlite:///data/pulseiq_live_dw.db"
scheduled_refresh_cron = "0 6 1 * *"
scheduled_refresh_day = "1st of every month at 06:00 UTC"
data_cut_off_date = "2026-09-30 23:59:59 UTC"

[admin]
notification_email = "board-alerts@pulseiq.internal"
admin_contact = "harish.bagavathy@pulseiq.internal"

[feature_flags]
enable_csv_download = true
enable_founder_5kpi_filter = true
enable_audit_drawer = true
